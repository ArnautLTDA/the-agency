# Credenciais de LLM
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=optional_fallback_key
ANTHROPIC_API_KEY=optional_fallback_key
ENGINE_API_KEY=agency-engine-secret-key-2026

# Concorrência e Execução
MAX_CONCURRENT_AGENTS=5
CIRCUIT_BREAKER_MAX_ITERATIONS=25
TERMINAL_BUFFER_MAX_BYTES=131072

# Message Broker (RabbitMQ)
RABBITMQ_URL=amqp://agency:agency123@127.0.0.1:5672/
MAX_QUEUE_CAPACITY=100

# Banco de Dados
DATABASE_URL=sqlite+aiosqlite:///pipeline.db
RETENTION_DAYS=30

# Servidor e Logs
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
LOG_FILE=logs/engine.log
LOG_ROTATION=10 MB
LOG_RETENTION=30 days

# Sandbox Docker
DOCKER_IMAGE=node:20-slim
DOCKER_MEMORY_LIMIT=2g
DOCKER_CPUS_LIMIT=1.5
DOCKER_PIDS_LIMIT=100
ALLOW_LOCAL_SUBPROCESS_DEV=false

# APIs Externas
AWESOME_API_URL=https://economia.awesomeapi.com.br/last/USD-BRL

# ==============================================================================
# PARAMETRIZAÇÃO DINÂMICA DE MODELOS DE IA (ZERO HARDCODED MODELS)
# ==============================================================================
DEFAULT_FAST_MODEL=gemini/gemini-2.5-flash
DEFAULT_REASONING_MODEL=gemini/gemini-3.8-pro

# Slots de Modelos do Pipeline Comercial (Fase 3)
MODEL_MINING_AGENT=gemini/gemini-2.5-flash
MODEL_DEMO_BUILDER_AGENT=gemini/gemini-2.5-flash
MODEL_SALES_EXECUTIVE_AGENT=gemini/gemini-2.5-flash
MODEL_OPTIMIZATION_AGENT=gemini/gemini-2.5-flash
MODEL_GUARDRAIL_AGENT=groq/llama-guard-3-8b

# ==============================================================================
# PARÂMETROS COMERCIAIS & LIMITES DE NEGOCIAÇÃO (BRL)
# ==============================================================================
PRICING_SETUP_BASE_BRL=1500.00
PRICING_SIGNAL_PERCENT=0.50
PRICING_DELIVERY_PERCENT=0.50
PRICING_MRR_BASE_BRL=250.00
PRICING_MAX_DISCOUNT_PERCENT=0.10

# ==============================================================================
# LIMITES OPERACIONAIS E ANTI-BAN DO WHATSAPP
# ==============================================================================
LIMIT_DAILY_OUTREACH_PER_CHIP=25
LIMIT_BUSINESS_HOURS_START=08:30
LIMIT_BUSINESS_HOURS_END=18:30
LIMIT_JITTER_MIN_SECONDS=15
LIMIT_JITTER_MAX_SECONDS=45
LIMIT_COMPOSING_MIN_SECONDS=3
LIMIT_COMPOSING_MAX_SECONDS=7
LIMIT_MAX_TURNS_PER_CONVERSATION=5
LIMIT_MAX_TOKEN_BUDGET_PER_LEAD_BRL=1.00
