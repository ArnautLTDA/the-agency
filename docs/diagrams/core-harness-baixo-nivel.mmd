            T_READ["read_file(path)"]
            T_WRITE["write_file(path, content)"]
            T_PATCH["patch_file(path, search, replace)"]
            T_LIST["list_directory(path)"]
            T_MSG["send_agent_message(to, type, payload)"]
        end

        subgraph DOCKER_SANDBOX["Sandbox Execution Driver (sandbox.py)"]
            DOCKER_CMD["run_terminal_command(command, timeout=30)<br/>• Isolamento Docker efêmero via DooD (/var/run/docker.sock)<br/>• Imagem: node:20-slim (sem privilégios root)<br/>• Limite de buffer de saída: 128 KB<br/>• Confinamento de workspace (SEC-001)"]
        end

        subgraph MCP_HOST["MCP Client Host (mcp_client.py & mcp_discovery.py)"]
            MCP_DISCO["MCPDiscoveryService<br/>Varre periodicamente :3005 a :3015 via tools/list"]
            MCP_CLI["MCPClientHost (SSE ClientSession)<br/>• Conexão HTTP/SSE com autenticação X-Agency-Key<br/>• list_tools() & call_tool(name, args)"]
        end

        TOOL_REG --> NATIVE_TOOLS
        TOOL_REG --> DOCKER_SANDBOX
        TOOL_REG --> MCP_HOST
    end

