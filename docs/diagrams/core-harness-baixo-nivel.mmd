    subgraph LIFECYCLE["🚀 LIFECYCLE & STARTUP SEQUENCE (main.py)"]
        direction TB
        BOOT["Início: uvicorn main:create_app (:8000)"]
        
        subgraph BOOT_STEPS["Sequência Lifespan Assíncrona"]
            L1["1. init_db() + create_db_and_tables()<br/>Ativa SQLite WAL Mode (pipeline.db)"]
            L2["2. Alembic Auto-Upgrade (SEC-019)<br/>Aplica migrações até 'head'"]
